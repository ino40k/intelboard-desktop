{
  "name": "intelboard-desktop",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "electron .",
    "build": "tsc -b && vite build && node scripts/notices.js",
    "test": "node --test tests/*.test.js",
    "package:linux": "npm run build && electron-builder --linux AppImage --x64 --publish never",
    "package:win": "node scripts/require-windows.js && npm run build && electron-builder --win nsis --x64 --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "audit:release": "node scripts/audit-release.js",
    "notices": "node scripts/notices.js",
    "test:desktop": "node scripts/smoke-desktop.js"
  },
  "dependencies": {
    "@xyflow/react": "^12.9.0",
    "cheerio": "^1.1.2",
    "dompurify": "^3.4.15",
    "epubjs": "^0.3.93",
    "ipaddr.js": "^2.2.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.4",
    "yauzl": "^3.4.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.15"
  },
  "description": "A private, standalone visual research workspace",
  "author": "IntelBoard contributors",
  "license": "MIT",
  "main": "desktop/main.js",
  "build": {
    "appId": "org.intelboard.desktop",
    "productName": "IntelBoard",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "desktop/**",
      "shared/**",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.txt",
      "build/icon.png",
      "licenses/**"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@img/**",
      "node_modules/sharp/**"
    ],
    "artifactName": "IntelBoard-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "executableName": "intelboard",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "npmRebuild": true,
    "appImage": {
      "executableArgs": []
    }
  },
  "desktopName": "org.intelboard.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/ino40k/intelboard-desktop.git"
  },
  "homepage": "https://github.com/ino40k/intelboard-desktop",
  "bugs": {
    "url": "https://github.com/ino40k/intelboard-desktop/issues"
  }
}
